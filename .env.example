# Скопируйте в .env и заполните боевыми значениями:
#   cp .env.example .env
# .env в git не попадает (см. .gitignore) — секреты живут только на сервере.

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных (Postgres; для локальной разработки можно USE_SQLITE=True) --
USE_SQLITE=True
POSTGRES_DB=photostudio
POSTGRES_USER=photostudio
POSTGRES_PASSWORD=photostudio
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS / CSRF (на проде — конкретные домены, не *) -------------------------
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- OAuth 2.0 -----------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_ID=

# --- Polza.ai (генерация фото и видео) -----------------------------------------
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
POLZA_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
POLZA_IMG2IMG_STRENGTH=0.4
POLZA_VIDEO_MODEL=google/gemini-omni-1.1-flash
POLZA_VIDEO_TIMEOUT_SEC=300
POLZA_VIDEO_POLL_INTERVAL_SEC=5

# --- Лимиты и цены видео (VideoLab AI MVP) -----------------------------------
VIDEO_MAX_DURATION_SEC=10
VIDEO_MAX_SIZE_MB=50
VIDEO_RETENTION_HOURS=48
VIDEO_PRICE_SINGLE=299.00
VIDEO_PRICE_PACK=849.00
CREDIT_BASE_REVENUE_RUB=219.00

# --- Yandex Cloud Object Storage (хранение результатов) -------------------------
YC_S3_ENDPOINT_URL=https://storage.yandexcloud.net
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_S3_BUCKET_NAME=photostudio-results
YC_S3_REGION=ru-central1

# Сколько часов хранить исходные фото пользователя после финального статуса заказа
UPLOAD_RETENTION_HOURS=24

# --- Почта (Resend по умолчанию; для локалки можно EmailBackend=console) --------
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=
# Фолбэк на SMTP (EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend):
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=True
SMTP_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@shotforjob.ru
SUPPORT_EMAIL=support@shotforjob.ru

# --- Frontend ------------------------------------------------------------------
# Публичный базовый URL самого сайта (без слэша на конце) — используется для
# редиректов после оплаты и для ссылок, которые бот шлёт пользователю
# (в т.ч. страница автоотправки формы на PayAnyWay, см. PAYANYWAY_* ниже).
FRONTEND_URL=http://localhost:8000

# --- Telegram-бот ----------------------------------------------------------------
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ссылка на канал с отзывами — кнопка в меню бота скрыта, если пусто.
TELEGRAM_REVIEWS_CHANNEL_URL=

# --- PayAnyWay / Moneta.ru (оплата пополнения баланса, в т.ч. из бота) -----------
# Номер расширенного счёта в системе MONETA.RU (личный кабинет moneta.ru — «Мои
# счета» → номер счёта). Аналог MerchantLogin у других платёжных систем.
PAYANYWAY_MNT_ID=
# Код проверки целостности данных — свойство расширенного счёта, задаётся в ЛК
# Moneta.ru (там же, где MNT_ID). Используется и для подписи исходящей формы
# оплаты, и для проверки подписи входящих уведомлений (Pay URL). Держите в
# секрете так же строго, как пароль — им можно подделать уведомление об оплате.
PAYANYWAY_INTEGRITY_CODE=
# На проде обязательно False — иначе платежи будут проходить в тестовом режиме
# Moneta.ru и деньги не спишутся по-настоящему (баланс при этом всё равно
# зачислится, если MNT_TEST_MODE у вас в ЛК не блокирует такие уведомления).
PAYANYWAY_TEST_MODE=True
PAYANYWAY_CURRENCY_CODE=RUB

# --- Продакшн-безопасность (учитываются только при DJANGO_DEBUG=False) ----------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
